<?xml version="1.0" encoding="UTF-8"?>
<agent key="armored_ghoul" family="ghoul" sprite="4">
  <body radius="38" collision="true" separation="true"/>
  <vitals health="800" experience="5000" lifetimeMs="0"/>
  <daylight damage="5" intervalMs="1000"/>
  <!-- The armor IS the <resistances>: fraction of incoming damage of that
		     kind shrugged off, the same semantics as a player's wearable
		     ...Resistance modifiers. Guns are the wrong tool for this one.
			 melee="0.5" piercing="0.6" explosion="0.3" energy="0.2" -->
  <resistances melee="0.1" explosion="0.1"/>
  <!-- No <dodge>: it walks through the burst. The armour IS its answer to
		     being shot, and a heavy that jinked would have both. -->
