    <!-- CONDITION RESISTANCE (2026-08-15). Any modifier named
         "<conditionKey>Resistance" protects against that condition: the fraction
         SHRINKS ITS DURATION and 1.0 blocks it outright. No code knows these
         keys - they are looked up by name off the condition being applied - so
         a new condition in conditions.xml is protectable the moment it exists.
         A helmet is the obvious place for stun. First-guess numbers. -->
    <wearable skinId="7" key="metal_helmet">
        <modifiers>
            <modifier key="meleeResistance" multiplier="0.15" />
            <modifier key="stunResistance" multiplier="0.3" />
