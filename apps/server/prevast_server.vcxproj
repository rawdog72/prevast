  <!-- Generated C++ view of shared/editor/limits.json (one limits source for C++ and TS).
       Needs Node on PATH, as every other build step in this repository does. -->
  <PropertyGroup>
    <PrevastGeneratedDir>$([System.IO.Path]::GetFullPath('$(MSBuildProjectDirectory)\..\..\build\generated\'))</PrevastGeneratedDir>
    <PrevastLimitsJson>$([System.IO.Path]::GetFullPath('$(MSBuildProjectDirectory)\..\..\shared\editor\limits.json'))</PrevastLimitsJson>
    <PrevastContractScript>$([System.IO.Path]::GetFullPath('$(MSBuildProjectDirectory)\..\..\tools\editor\generate-contract.mjs'))</PrevastContractScript>
  </PropertyGroup>
  <Target Name="PrevastEditorContract" BeforeTargets="ClCompile;PrepareForBuild"
          Inputs="$(PrevastLimitsJson);$(PrevastContractScript)"
          Outputs="$(PrevastGeneratedDir)contract\editor_limits.h">
    <Exec Command="node &quot;$(PrevastContractScript)&quot; --out &quot;$(PrevastGeneratedDir)contract\editor_limits.h&quot;" />
  </Target>
  <!-- vcpkg deploys its DLLs (fmt, lua51, pugixml, libmariadb, boost_json, z)
       only when the exe is relinked, so once they went missing a build with no
       source change never brought them back and the server would not start.
       Run vcpkg's own deploy script as the build's last step, every build: it
       copies only what is missing or out of date, and it is not recorded as a
       tracked write, so IncrementalClean has nothing of it to remove. -->
  <Target Name="PrevastDeployVcpkgDlls" AfterTargets="Build"
          Condition="'$(_ZVcpkgCurrentInstalledDir)' != '' and Exists('$(TargetPath)')">
    <Exec Command="&quot;$(SystemRoot)\System32\WindowsPowerShell\v1.0\powershell.exe&quot; -ExecutionPolicy Bypass -NoProfile -File &quot;$(_ZVcpkgRoot)scripts\buildsystems\msbuild\applocal.ps1&quot; &quot;$(TargetPath)&quot; &quot;$(_ZVcpkgCurrentInstalledDir)$(_ZVcpkgConfigSubdir)bin&quot;"
          StandardOutputImportance="low" />
  </Target>
